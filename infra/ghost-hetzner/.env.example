# Copy to .env and fill in. This file is sourced by bash, so quote values that contain spaces.

# Hetzner Cloud project API token (Read & Write): Cloud Console > Security > API tokens
HCLOUD_TOKEN=

# Cloudflare API token: Account > Cloudflare Tunnel: Edit, Account > Access: Apps and Policies: Edit, Zone > DNS: Edit, Zone > Zone: Read
CF_API_TOKEN=

# Domain already added to that Cloudflare account
CF_ZONE=example.com

# Who may SSH in through Cloudflare Access (comma separated); the first one also becomes the Ghost owner
ADMIN_EMAIL=you@example.com

# Optional, defaults shown
# BLOG_HOSTNAME=blog.example.com
# SSH_HOSTNAME=ssh.example.com
# SERVER_NAME=ghost-blog
# SERVER_TYPE=cx22
# SERVER_LOCATION=nbg1
# SERVER_IMAGE=ubuntu-24.04
# SSH_USER=admin
# SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
# TUNNEL_NAME=ghost-blog
# GHOST_OWNER_NAME=Admin
# GHOST_OWNER_EMAIL=you@example.com
# GHOST_BLOG_TITLE="My Ghost Blog"
# DEPLOY_TIMEOUT=900
# POLL_INTERVAL=10

# Optional SMTP so Ghost can send staff invites and password resets
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# GHOST_MAIL_FROM=blog@example.com
